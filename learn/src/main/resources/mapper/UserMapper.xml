<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.UserMapper">

    <!-- 结果映射（驼峰命名由 mybatis.configuration.map-underscore-to-camel-case=true 自动处理） -->
    <resultMap id="UserResultMap" type="com.example.demo.entity.pg.User">
        <id     property="id"        column="id"/>
        <result property="username"  column="username"/>
        <result property="email"     column="email"/>
        <result property="phone"     column="phone"/>
        <result property="nickname"  column="nickname"/>
        <result property="avatarUrl" column="avatar_url"/>
        <result property="status"    column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- 通用列 -->
    <sql id="Base_Column_List">
        id, username, email, phone, nickname, avatar_url, status, created_at, updated_at
    </sql>

    <!-- 根据 ID 查询 -->
    <select id="selectById" resultMap="UserResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM users
        WHERE id = #{id}
    </select>

    <!-- 根据用户名查询 -->
    <select id="selectByUsername" resultMap="UserResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM users
        WHERE username = #{username}
        LIMIT 1
    </select>

    <!-- 分页列表 -->
    <select id="selectList" resultMap="UserResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM users
        ORDER BY id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- 总数 -->
    <select id="count" resultType="long">
        SELECT COUNT(*) FROM users
    </select>

    <!-- 新增（PostgreSQL RETURNING id 回填主键） -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO users (username, email, phone, nickname, avatar_url, status, created_at, updated_at)
        VALUES (
            #{username},
            #{email},
            #{phone},
            #{nickname},
            #{avatarUrl},
            #{status, jdbcType=INTEGER},
            NOW(),
            NOW()
        )
    </insert>

    <!-- 动态更新（只更新非 null 字段） -->
    <update id="updateById">
        UPDATE users
        <set>
            <if test="username  != null">username   = #{username},</if>
            <if test="email     != null">email      = #{email},</if>
            <if test="phone     != null">phone      = #{phone},</if>
            <if test="nickname  != null">nickname   = #{nickname},</if>
            <if test="avatarUrl != null">avatar_url = #{avatarUrl},</if>
            <if test="status    != null">status     = #{status},</if>
            updated_at = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <!-- 删除 -->
    <delete id="deleteById">
        DELETE FROM users WHERE id = #{id}
    </delete>

</mapper>

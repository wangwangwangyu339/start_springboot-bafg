# ============================================================
# 环境变量示例文件
# 复制此文件为 .env 并填入真实值（.env 已加入 .gitignore）
# ============================================================

# PostgreSQL
PG_HOST=your-pg-host.example.com
PG_PORT=5432
PG_DB=demo
PG_USER=postgres
PG_PASSWORD=your_pg_password

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/demo?retryWrites=true&w=majority
MONGODB_DB=demo

# Upstash Redis (SSL 连接，rediss:// 协议)
REDIS_URL=rediss://default:your_upstash_token@your-endpoint.upstash.io:6379

# Vercel Edge Config
EDGE_CONFIG=https://edge-config.vercel.com/ecfg_xxxxxxxxxxxxxxxxxx?token=your_readonly_token

# Sentry
SENTRY_DSN=https://your_public_key@o000000.ingest.sentry.io/000000

# Spring Profile
SPRING_PROFILES_ACTIVE=production
